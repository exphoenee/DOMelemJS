{
  "name": "domelemjs",
  "version": "2.0.1",
  "type": "module",
  "description": "A lightweight, zero-dependency TypeScript library for dynamically creating HTML elements from JavaScript.",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README-hu.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exphoenee/DOMelemJS.git"
  },
  "keywords": [
    "rendering",
    "DOM",
    "dynamic",
    "webapp",
    "typescript"
  ],
  "author": "VIKTOR, Bozzay",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/exphoenee/DOMelemJS/issues"
  },
  "homepage": "https://github.com/exphoenee/DOMelemJS#readme",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.2.0"
  }
}